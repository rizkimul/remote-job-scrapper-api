# App
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=changeme

# Database
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraper
POSTGRES_DB=scraper_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://scraper:scraper@postgres:5432/scraper_db

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Scraping
SCRAPE_DELAY_MIN=2
SCRAPE_DELAY_MAX=5
SCRAPE_USER_AGENT=ScraperPipelineAPI/1.0 (+https://github.com/rizkimul/scraper-pipeline-api)

# Email (for digest — fill in before Step 8)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM_EMAIL=
